---
import type { MarkdownHeading } from 'astro';

export interface Props {
  headings: MarkdownHeading[];
  label: string;
  variant: 'mobile' | 'desktop';
  /** Ordered milestone phrases for the reading-progress meter (desktop only). */
  progress?: string[];
}

const { headings, label, variant, progress } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && variant === 'mobile' && (
    <details class="post-toc post-toc--mobile">
      <summary>{label}</summary>
      <ol class="post-toc__list">
        {items.map((h, i) => (
          <li class={`post-toc__item post-toc__item--d${h.depth}`}>
            <a href={`#${h.slug}`} data-toc-link={h.slug}>
              <span class="post-toc__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="post-toc__text">{h.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </details>
  )
}

{
  items.length > 0 && variant === 'desktop' && (
    <aside class="post-toc post-toc--desktop" aria-label={label}>
      {progress && progress.length > 0 && (
        <div
          class="reading-progress"
          data-reading-progress
          data-progress-phrases={JSON.stringify(progress)}
        >
          <div class="reading-progress__head">
            <span class="reading-progress__label" data-progress-label>{progress[0]}</span>
            <span class="reading-progress__pct" data-progress-pct>0%</span>
          </div>
          <div class="reading-progress__track">
            <span class="reading-progress__bar" data-progress-bar />
          </div>
        </div>
      )}
      <p class="post-toc__label">{label}</p>
      <ol class="post-toc__list">
        {items.map((h, i) => (
          <li class={`post-toc__item post-toc__item--d${h.depth}`}>
            <a href={`#${h.slug}`} data-toc-link={h.slug}>
              <span class="post-toc__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="post-toc__text">{h.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </aside>
  )
}

<script>
  // View-transition-safe scroll-spy: rebuild on every page load, disconnect the
  // observer before a swap so it doesn't observe detached nodes after navigation.
  let observer: IntersectionObserver | null = null;

  function initToc() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
    if (links.length === 0) return;

    const slugs: string[] = [];
    const seen = new Set<string>();
    links.forEach((link) => {
      const slug = link.dataset.tocLink!;
      if (!seen.has(slug)) {
        seen.add(slug);
        slugs.push(slug);
      }
    });

    const setActive = (slug: string | null) => {
      links.forEach((link) => {
        if (slug && link.dataset.tocLink === slug) {
          link.setAttribute('data-active', '');
        } else {
          link.removeAttribute('data-active');
        }
      });
    };

    const visible = new Set<string>();
    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const id = entry.target.id;
          if (entry.isIntersecting) visible.add(id);
          else visible.delete(id);
        });
        const firstVisible = slugs.find((id) => visible.has(id));
        if (firstVisible) setActive(firstVisible);
      },
      { rootMargin: '-80px 0px -65% 0px', threshold: 0 }
    );

    slugs.forEach((slug) => {
      const el = document.getElementById(slug);
      if (el) observer!.observe(el);
    });

    if (slugs[0]) setActive(slugs[0]);
  }

  function teardownToc() {
    observer?.disconnect();
    observer = null;
  }

  // Reading-progress meter: track how far through the article body the viewport
  // has scrolled, updating the bar/percentage/label. rAF-throttled scroll work.
  let rpCleanup: (() => void) | null = null;

  function initProgress() {
    const widget = document.querySelector<HTMLElement>('[data-reading-progress]');
    const body = document.querySelector<HTMLElement>('.post-body');
    if (!widget || !body) return;
    const bar = widget.querySelector<HTMLElement>('[data-progress-bar]');
    const pctEl = widget.querySelector<HTMLElement>('[data-progress-pct]');
    const labelEl = widget.querySelector<HTMLElement>('[data-progress-label]');
    if (!bar || !pctEl || !labelEl) return;

    /** @type {string[]} */
    let phrases: string[] = [];
    try {
      phrases = JSON.parse(widget.dataset.progressPhrases || '[]');
    } catch {
      phrases = [];
    }
    // Spread the leading phrases evenly across 0–99%; the final phrase is
    // reserved for 100%, so the label changes several times as you scroll.
    const phraseFor = (pct: number) => {
      if (phrases.length === 0) return '';
      if (pct >= 100) return phrases[phrases.length - 1];
      const bands = Math.max(1, phrases.length - 1);
      return phrases[Math.min(bands - 1, Math.floor((pct / 100) * bands))];
    };

    let raf = 0;
    const update = () => {
      raf = 0;
      const rect = body.getBoundingClientRect();
      const top = rect.top + window.scrollY;
      const span = body.offsetHeight;
      const viewBottom = window.scrollY + window.innerHeight;
      const p = span > 0 ? Math.max(0, Math.min(1, (viewBottom - top) / span)) : 1;
      const pct = Math.round(p * 100);
      bar.style.width = pct + '%';
      pctEl.textContent = pct + '%';
      labelEl.textContent = phraseFor(pct);
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();

    rpCleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      if (raf) cancelAnimationFrame(raf);
    };
  }

  function teardownProgress() {
    rpCleanup?.();
    rpCleanup = null;
  }

  function init() {
    initToc();
    initProgress();
  }
  function teardown() {
    teardownToc();
    teardownProgress();
  }

  // PostTOC only renders on blog post pages, which have ClientRouter, so
  // `astro:page-load` fires on the initial load and after every swap.
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
</script>
