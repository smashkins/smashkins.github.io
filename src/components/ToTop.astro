---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button class="to-top" aria-label={label} title={label} data-to-top>
  <span aria-hidden="true">↑</span>
</button>

<script>
  // View-transition-safe: re-init on every page load and tear down the window
  // scroll listener before a swap so it never leaks across navigations.
  let onScroll: (() => void) | null = null;

  function initToTop() {
    const btn = document.querySelector<HTMLButtonElement>('[data-to-top]');
    if (!btn) return;
    onScroll = () => {
      btn.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.8);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    btn.addEventListener('click', () => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });
  }

  function teardownToTop() {
    if (onScroll) {
      window.removeEventListener('scroll', onScroll);
      onScroll = null;
    }
  }

  // ToTop only renders on blog pages, which have ClientRouter, so
  // `astro:page-load` fires on the initial load and after every swap.
  document.addEventListener('astro:page-load', initToTop);
  document.addEventListener('astro:before-swap', teardownToTop);
</script>
