---
import { type Locale, t } from '~/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

// Giscus configuration. `repoId` / `categoryId` are public (not secrets) and
// safe to commit. Obtain them from https://giscus.app after enabling
// Discussions on the repo, installing the giscus GitHub App, and creating the
// `Comments` category. Until the real IDs are in, the widget renders a
// "not installed" notice but the page is otherwise unaffected.
const giscus = {
  repo: 'smashkins/smashkins.github.io',
  repoId: 'R_kgDOScmrbw',
  category: 'Comments',
  categoryId: 'DIC_kwDOScmrb84C_lnv',
};

// Absolute URL so the giscus iframe (on giscus.app) can load the theme
// cross-origin. Resolves against `site` (https://monoidx.dev) from astro.config.
const themeUrl = new URL('/giscus-monoidx.css', Astro.site).href;
---

<section class="post-comments" aria-label={strings.blog.comments}>
  <p class="eyebrow post-comments__label">{strings.blog.comments}</p>
  <div
    data-giscus
    data-repo={giscus.repo}
    data-repo-id={giscus.repoId}
    data-category={giscus.category}
    data-category-id={giscus.categoryId}
    data-theme={themeUrl}
  >
  </div>
</section>

<script>
  // View-transition-safe giscus loader, mirroring the PostTOC / ToTop pattern:
  // (re)build the widget on every page load, and remove the injected iframe
  // before a swap so it never leaks across navigations. `data-mapping=pathname`
  // means each locale/post (distinct path) gets its own discussion thread.
  function loadGiscus() {
    const container = document.querySelector<HTMLElement>('[data-giscus]');
    if (!container) return;

    // Clear any previous render (defensive — teardown should already have run).
    container.innerHTML = '';

    const lang = document.documentElement.lang === 'it' ? 'it' : 'en';

    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.async = true;
    script.crossOrigin = 'anonymous';

    script.setAttribute('data-repo', container.dataset.repo!);
    script.setAttribute('data-repo-id', container.dataset.repoId!);
    script.setAttribute('data-category', container.dataset.category!);
    script.setAttribute('data-category-id', container.dataset.categoryId!);
    script.setAttribute('data-mapping', 'pathname');
    script.setAttribute('data-strict', '0');
    script.setAttribute('data-reactions-enabled', '1');
    script.setAttribute('data-emit-metadata', '0');
    script.setAttribute('data-input-position', 'top');
    script.setAttribute('data-theme', container.dataset.theme!);
    script.setAttribute('data-lang', lang);
    script.setAttribute('data-loading', 'lazy');

    container.appendChild(script);
  }

  function teardownGiscus() {
    const container = document.querySelector<HTMLElement>('[data-giscus]');
    if (container) container.innerHTML = '';
  }

  document.addEventListener('astro:page-load', loadGiscus);
  document.addEventListener('astro:before-swap', teardownGiscus);
</script>
