---
// Minimal background-music player: streams the audio of a YouTube playlist on
// loop via the IFrame Player API (hidden video). Play / Stop + a volume slider,
// in the MONOIDX style. The wrapper is `transition:persist`ed so the iframe —
// and thus the audio and the chosen volume — survive blog view-transition navs.
const PLAYLIST = 'PLDQmiNJl6F54';
---

<div class="bg-player" id="bg-player" transition:persist="bg-player" data-playlist={PLAYLIST}>
  <button class="bg-player__btn" data-bg-play type="button" aria-label="Play background music" title="Play">
    <span aria-hidden="true">&#9654;</span>
  </button>
  <button class="bg-player__btn" data-bg-stop type="button" aria-label="Stop background music" title="Stop" disabled>
    <span aria-hidden="true">&#9632;</span>
  </button>
  <svg class="bg-player__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <!-- three concentric waves (centered at x=4,y=12, radii 7/11/15), drawn
         first so the filled cone overlaps their inner ends for a clean emerge -->
    <path d="M9.36 7.5a7 7 0 0 1 0 9" />
    <path d="M12.43 4.93a11 11 0 0 1 0 14.14" />
    <path d="M15.49 2.36a15 15 0 0 1 0 19.28" />
    <polygon points="2 9 6 9 10 5 10 19 6 15 2 15" />
  </svg>
  <input
    class="bg-player__vol"
    data-bg-vol
    type="range"
    min="0"
    max="100"
    step="1"
    value="55"
    aria-label="Volume"
    title="Volume"
  />
  <div class="bg-player__frame" aria-hidden="true"><div id="bg-player-yt"></div></div>
</div>

<style>
  .bg-player {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .bg-player__btn {
    width: 30px;
    height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    appearance: none;
    border-radius: 0;
    background: transparent;
    border: 1px solid var(--line-2);
    color: var(--txt-3);
    font-family: var(--mono);
    font-size: 10px;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color 0.35s var(--ease),
      color 0.35s var(--ease),
      opacity 0.35s var(--ease);
  }
  .bg-player__btn:hover:not(:disabled) {
    border-color: var(--silver);
    color: var(--txt-1);
  }
  .bg-player__btn[data-bg-play] { font-size: 9px; }
  .bg-player__btn:disabled {
    color: var(--txt-4);
    cursor: default;
  }
  /* the active (currently-available) control reads brighter */
  .bg-player.is-playing [data-bg-stop],
  .bg-player:not(.is-playing) [data-bg-play] {
    color: var(--silver);
    border-color: var(--line-2);
  }

  /* speaker glyph — labels the slider as volume; cone filled, waves stroked */
  .bg-player__icon {
    width: 16px;
    height: 16px;
    margin-right: -2px;
    color: var(--txt-3);
    flex: none;
  }
  .bg-player__icon polygon {
    fill: currentColor;
  }
  .bg-player__icon path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* volume slider — wedge track (thin→thick = low→high), small square thumb */
  .bg-player__vol {
    -webkit-appearance: none;
    appearance: none;
    width: 56px;
    height: 14px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }
  .bg-player__vol::-webkit-slider-runnable-track {
    height: 8px;
    background: var(--line-2);
    /* triangle: a sliver at the left growing to full height at the right */
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .bg-player__vol::-moz-range-track {
    height: 8px;
    background: var(--line-2);
    clip-path: polygon(0 100%, 100% 0, 100% 100%);
  }
  .bg-player__vol::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 7px;
    height: 7px;
    margin-top: 1px;
    border-radius: 0;
    background: var(--txt-3);
    transition: background 0.3s var(--ease);
  }
  .bg-player__vol::-moz-range-thumb {
    width: 7px;
    height: 7px;
    border: 0;
    border-radius: 0;
    background: var(--txt-3);
  }
  .bg-player__vol:hover::-webkit-slider-thumb,
  .bg-player__vol:focus-visible::-webkit-slider-thumb { background: var(--silver); }
  .bg-player__vol:hover::-moz-range-thumb,
  .bg-player__vol:focus-visible::-moz-range-thumb { background: var(--silver); }

  /* disabled + hidden on mobile (see the matching guard in the script) */
  @media (max-width: 760px) {
    .bg-player { display: none; }
  }

  /* visually-hidden iframe mount — NOT display:none, so audio keeps playing */
  .bg-player__frame {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    left: -9999px;
    top: 0;
  }
</style>

<script>
  // Now-playing ticker state (module scope so it can be repainted after a
  // view-transition navigation, when the nav — and its ticker — re-render).
  let currentTitle = '';
  let isPlaying = false;

  function paintTicker() {
    const ticker = document.querySelector('[data-bg-ticker]');
    if (!ticker) return;
    ticker.querySelectorAll('[data-bg-ticker-text]').forEach((el) => {
      el.textContent = currentTitle;
    });
    const on = isPlaying && !!currentTitle;
    ticker.classList.toggle('is-on', on);
    if (on) {
      const track = ticker.querySelector<HTMLElement>('[data-bg-ticker-track]');
      const copy = ticker.querySelector<HTMLElement>('[data-bg-ticker-text]');
      if (track && copy) {
        // one copy (incl. its separator) is half the track; -50% scrolls exactly
        // that far, so duration = copyWidth / speed keeps a constant ~30px/s.
        const copyW = copy.getBoundingClientRect().width;
        if (copyW > 0) track.style.setProperty('--np-dur', Math.max(8, copyW / 30) + 's');
      }
    }
  }

  // Guard: with `transition:persist`, this bundled module may be re-evaluated on
  // a client navigation, but the player + listeners must be created only once.
  function setupBgPlayer() {
    // Disabled on mobile: don't load the iframe API, arm autostart, or play.
    if (window.matchMedia('(max-width: 760px)').matches) return;
    const w = window as unknown as {
      __bgPlayer?: boolean;
      YT?: any;
      onYouTubeIframeAPIReady?: () => void;
    };
    if (w.__bgPlayer) return;
    const root = document.getElementById('bg-player');
    const mount = document.getElementById('bg-player-yt');
    if (!root || !mount) return;
    w.__bgPlayer = true;

    const playBtn = root.querySelector<HTMLButtonElement>('[data-bg-play]');
    const stopBtn = root.querySelector<HTMLButtonElement>('[data-bg-stop]');
    const volEl = root.querySelector<HTMLInputElement>('[data-bg-vol]');
    const playlist = root.dataset.playlist || '';
    const VOL_KEY = 'bg-player-volume';
    let player: any = null;
    let autoStart = true; // keep trying to start on gestures until playback begins
    let gestured = false; // the visitor has interacted at least once

    // Restore saved volume (default 55) into the slider before the API is ready.
    const savedVol = (() => {
      const raw = Number(localStorage.getItem(VOL_KEY));
      return Number.isFinite(raw) && raw >= 0 && raw <= 100 ? raw : 55;
    })();
    if (volEl) volEl.value = String(savedVol);

    let pollId = 0;
    function checkTitle() {
      try {
        const data = player && player.getVideoData ? player.getVideoData() : null;
        const title = data && data.title ? String(data.title) : '';
        if (title && title !== currentTitle) {
          currentTitle = title;
          paintTicker();
        }
      } catch {
        /* getVideoData not ready yet */
      }
    }
    function startPoll() {
      checkTitle();
      if (!pollId) pollId = window.setInterval(checkTitle, 2000);
    }
    function stopPoll() {
      if (pollId) {
        clearInterval(pollId);
        pollId = 0;
      }
    }

    function reflect(playing: boolean) {
      root!.classList.toggle('is-playing', playing);
      if (playBtn) playBtn.disabled = playing;
      if (stopBtn) stopBtn.disabled = !playing;
      isPlaying = playing;
      if (playing) startPoll();
      else stopPoll();
      paintTicker();
    }

    const GESTURES = ['click', 'scroll', 'keydown', 'touchstart'];
    // Try to start on EVERY gesture (not just the first). On a cold direct
    // arrival the YouTube player can take a second or two to load, so the first
    // gesture may land before it exists; retrying within real gesture windows
    // (required by autoplay policy) means a later scroll/click still starts it.
    function tryAutoStart() {
      if (!autoStart) return;
      gestured = true;
      player?.playVideo?.();
    }
    function endAutoStart() {
      if (!autoStart) return;
      autoStart = false;
      GESTURES.forEach((ev) =>
        window.removeEventListener(ev, tryAutoStart, { capture: true } as any),
      );
    }

    playBtn?.addEventListener('click', () => {
      gestured = true;
      player?.playVideo?.(); // onStateChange(PLAYING) ends auto-start arming
    });
    stopBtn?.addEventListener('click', () => {
      endAutoStart(); // user opted out — don't let a later gesture restart it
      player?.pauseVideo?.(); // "stop" = pause so Play resumes cleanly
    });
    volEl?.addEventListener('input', () => {
      const v = Number(volEl.value);
      localStorage.setItem(VOL_KEY, String(v));
      player?.setVolume?.(v);
    });
    GESTURES.forEach((ev) =>
      window.addEventListener(ev, tryAutoStart, { capture: true, passive: true } as any),
    );

    function createPlayer() {
      const YT = w.YT;
      if (!YT || !YT.Player) return;
      player = new YT.Player('bg-player-yt', {
        width: '1',
        height: '1',
        playerVars: {
          listType: 'playlist',
          list: playlist,
          loop: 1,
          autoplay: 0,
          controls: 0,
          disablekb: 1,
          fs: 0,
          modestbranding: 1,
          playsinline: 1,
          rel: 0,
          origin: location.origin,
        },
        events: {
          onReady: (e: any) => {
            e.target.setVolume(savedVol);
            // If the visitor already interacted before the player finished
            // loading, start now (Chrome keeps sticky activation; otherwise the
            // next gesture's tryAutoStart starts it).
            if (gestured && autoStart) e.target.playVideo();
          },
          onStateChange: (e: any) => {
            const S = w.YT.PlayerState;
            const playing = e.data === S.PLAYING || e.data === S.BUFFERING;
            reflect(playing);
            if (playing) endAutoStart(); // playback began — stop retrying
            if (e.data === S.ENDED) e.target.playVideo(); // loop fallback
          },
        },
      });
    }

    // Load the IFrame API once, then create the player.
    if (w.YT && w.YT.Player) {
      createPlayer();
    } else {
      const prev = w.onYouTubeIframeAPIReady;
      w.onYouTubeIframeAPIReady = () => {
        prev?.();
        createPlayer();
      };
      if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
        const tag = document.createElement('script');
        tag.src = 'https://www.youtube.com/iframe_api';
        document.head.appendChild(tag);
      }
    }
  }

  setupBgPlayer();
  document.addEventListener('astro:page-load', setupBgPlayer);
  // Re-sync the (re-rendered) ticker after a view-transition navigation.
  document.addEventListener('astro:page-load', paintTicker);
</script>
