---
import { hasItems, PF_CONTEXT_LABELS, type PortfolioProject } from '~/utils/landing';
import { renderMarkdown } from '~/utils/markdown';
import { resolveVideo } from '~/utils/video';

interface Props {
  projects: PortfolioProject[];
}

const { projects } = Astro.props;

const panels = await Promise.all(
  projects.map(async (p) => ({ project: p, descriptionHtml: await renderMarkdown(p.description) }))
);
---

<div class="pf-modal" id="pfModal" role="dialog" aria-modal="true" aria-label="Project details" aria-hidden="true">
  {panels.map(({ project: p, descriptionHtml }) => (
    <div class="pf-modal-panel" data-project={p.slug}>
      <span class="br tl"></span><span class="br tr"></span>
      <span class="br bl"></span><span class="br br2"></span>
      <button class="rd-close pf-modal-close" type="button" aria-label="Close">×</button>
      <div class="pf-modal-inner">
        <div class="eyebrow no-rule pf-modal-eyebrow">{p.platform}</div>
        <div class="pf-modal-head">
          <h3 class="pf-modal-title" id={`project-title-${p.slug}`}>{p.title}</h3>
          {p.date && <span class="pf-modal-date">{p.date}</span>}
        </div>
        {descriptionHtml && <div class="pf-modal-desc" set:html={descriptionHtml} />}

        <div class="pf-specs">
          {p.specs?.map((s) => (
            <div class="pf-spec-row"><span class="k">{s.label}</span><span class="v">{s.value}</span></div>
          ))}
          {p.client && <div class="pf-spec-row"><span class="k">Client</span><span class="v">{p.client}</span></div>}
          <div class="pf-spec-row"><span class="k">Context</span><span class="v">{PF_CONTEXT_LABELS[p.context]}</span></div>
        </div>

        {(hasItems(p.images) || hasItems(p.videos)) && (
          <div class="pf-gallery">
            {p.images?.map((src) => (
              <img src={src} alt={`${p.title} — preview`} loading="lazy" />
            ))}
            {p.videos?.map((v) => {
              const rv = resolveVideo(v);
              return rv.kind === 'embed' ? (
                <div class="pf-embed">
                  <iframe
                    src={rv.url}
                    title={rv.title ?? `${p.title} — video`}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                  ></iframe>
                </div>
              ) : (
                <video class="pf-video" muted loop playsinline controls preload="metadata" poster={rv.poster}>
                  <source src={rv.src} type="video/mp4" />
                </video>
              );
            })}
          </div>
        )}

        {hasItems(p.links) && (
          <div class="pf-modal-links">
            {p.links.map((link) => (
              <a class="rd-portfolio-link" href={link.href} target="_blank" rel="noopener noreferrer"><span>{link.label}</span><span class="ar">↗</span></a>
            ))}
          </div>
        )}
      </div>
    </div>
  ))}
</div>
