---
import type { GetStaticPaths, Page } from 'astro';
import BlogLayout from '~/layouts/BlogLayout.astro';
import PostCard from '~/components/PostCard.astro';
import Pagination from '~/components/Pagination.astro';
import BlogSearch from '~/components/BlogSearch.astro';
import { getPosts, type BlogEntry } from '~/utils/blog';
import { switchLocalePath, t, type Locale } from '~/i18n';

const LOCALE: Locale = 'en';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts('en');
  return paginate(posts, { pageSize: 8 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<BlogEntry> };
const strings = t(LOCALE);
const enHref = new URL(Astro.url.pathname, Astro.site).href;
const itHref = new URL(switchLocalePath(Astro.url.pathname, 'it'), Astro.site).href;
---

<BlogLayout
  title={page.currentPage > 1 ? `${strings.blog.title} — ${strings.blog.page} ${page.currentPage}` : `${strings.blog.title} · MONOIDX`}
  description={strings.blog.subtitle}
  locale={LOCALE}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="it" href={itHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
  </Fragment>

  <header class="blog-header">
    <p class="eyebrow">{strings.blog.eyebrow}</p>
    <h1 class="blog-header__title">{strings.blog.title}<span class="blog-header__cursor" aria-hidden="true">_</span></h1>
    <p class="blog-header__subtitle">{strings.blog.subtitle}</p>
  </header>

  <BlogSearch locale={LOCALE} indexUrl="/blog/search.json" />

  <div class="post-list">
    {page.data.map((entry) => (
      <PostCard entry={entry} locale={LOCALE} />
    ))}
  </div>

  <Pagination
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    locale={LOCALE}
  />
</BlogLayout>
