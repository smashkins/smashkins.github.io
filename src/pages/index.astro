---
import BaseLayout from '~/layouts/BaseLayout.astro';
import MusicPlayer from '~/components/MusicPlayer.astro';
import NavMenu from '~/components/NavMenu.astro';
import NowPlaying from '~/components/NowPlaying.astro';
import ToTop from '~/components/ToTop.astro';
import { frontmatter as resume } from '~/data/resume.md';
import { frontmatter as portfolio } from '~/data/portfolio.md';

type ProjectContext = 'employed' | 'freelance' | 'indie';
interface TextLink {
  label: string;
  href: string;
}
interface ResumeJob {
  role: string;
  period: string;
  org: string;
  note?: string;
  notes?: string[];
}
interface ResumeMetaRow {
  label: string;
  value: string;
  note?: string;
  led?: boolean;
}
interface ResumeSkillGroup {
  category: string;
  items?: string[];
}
interface ResumeData {
  name: string;
  role: string;
  summary: string;
  jobs?: ResumeJob[];
  meta?: ResumeMetaRow[];
  skills?: ResumeSkillGroup[];
  metaAfter?: ResumeMetaRow[];
  portfolio?: TextLink[];
}
interface PortfolioSpec {
  label: string;
  value: string;
}
type PortfolioVideo = string | { src: string; poster?: string };
interface PortfolioProject {
  slug: string;
  context: ProjectContext;
  experimental?: boolean;
  platform: string;
  title: string;
  date?: string;
  summary: string;
  description?: string;
  specs?: PortfolioSpec[];
  images?: string[];
  videos?: PortfolioVideo[];
  links?: TextLink[];
}
interface PortfolioData {
  eyebrow?: string;
  title?: string;
  intro?: string;
  projects?: PortfolioProject[];
}
type NoteSegment = { text: string; project?: string };

const resumeData = resume as ResumeData;
const portfolioData = portfolio as PortfolioData;
const pfProjects = portfolioData.projects ?? [];
const PF_PAGE_SIZE = 6;                                       // Selected Work: projects per page

// Filter pills are derived from the projects' `context` + `experimental` fields.
const PF_CONTEXT_ORDER = ['employed', 'freelance', 'indie'] as const;
const PF_CONTEXT_LABELS: Record<ProjectContext, string> = { employed: 'Employed', freelance: 'Freelance', indie: 'Indie' };
const pfContexts = PF_CONTEXT_ORDER.filter((c) => pfProjects.some((p) => p.context === c));
const pfHasExperimental = pfProjects.some((p) => p.experimental);
const pfHasFilters = pfContexts.length > 1 || pfHasExperimental;

// Parse a note string into text / project-link segments.
// Syntax in resume.md:  [Eolo](project:eolo)  →  links the word "Eolo" to the
// portfolio project whose slug is "eolo" (opens its detail HUD on click).
const pfSlugs = new Set(pfProjects.map((p) => p.slug));
function parseNote(text: string): NoteSegment[] {
  const segments: NoteSegment[] = [];
  const re = /\[([^\]]+)\]\(project:([^)]+)\)/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(text)) !== null) {
    if (m.index > last) segments.push({ text: text.slice(last, m.index) });
    segments.push({ text: m[1], project: m[2] });
    last = m.index + m[0].length;
  }
  if (last < text.length) segments.push({ text: text.slice(last) });
  return segments;
}

function hasItems<T>(items: T[] | undefined): items is T[] {
  return Array.isArray(items) && items.length > 0;
}
---

<BaseLayout
  title="MONOIDX — Sequence"
  description="MONOIDX is Vincenzo S.'s Apple platform engineering identity: iOS, SwiftUI, architecture, AI-assisted development, and selected shipped work."
  ogImage="/assets/hero.jpg"
  bodyClass="scroll-edition"
>
  <link slot="head" rel="stylesheet" href="/scroll.css" />

  <!-- loading veil -->
  <div class="veil" id="veil"><div class="lbl">INITIALISING UNIT <b>MX-1</b></div></div>

  <!-- top scrub progress -->
  <div class="scrub-progress"><div class="fill" id="scrubFill"></div></div>

  <!-- parallax backdrop -->
  <div class="bg-field" id="bgField">
    <div class="vline" data-depth="0.15" style="left:18%"></div>
    <div class="vline" data-depth="0.3"  style="left:50%"></div>
    <div class="vline" data-depth="0.2"  style="left:82%"></div>
    <div class="ghost" id="ghost">MX</div>
  </div>

  <!-- nav -->
  <nav class="nav" id="nav">
    <button class="brand" id="brandHome" type="button" aria-label="MONOIDX, back to top">MONOIDX</button>
    <div class="nav-cluster">
      <div class="nav-cluster-row">
        <div class="nav-links" id="landing-nav-menu" data-nav-menu>
          <a href="/blog/">Articles</a>
          <a href="/#resume">Resume</a>
          <a href="#portfolio">Portfolio</a>
          <a href="#contact" class="nav-cta">Contact</a>
        </div>
        <MusicPlayer />
        <NavMenu controls="landing-nav-menu" />
      </div>
      <NowPlaying />
    </div>
  </nav>

  <!-- ===================== SCROLL SEQUENCE ===================== -->
  <section class="scrolly" id="scrolly">
    <div class="stage" id="stage" data-screen-label="Sequence">

      <div class="video-wrap" id="videoWrap">
        <canvas id="seqCanvas"></canvas>
      </div>

      <div class="scrim vig"></div>
      <div class="scrim left" id="scrimLeft"></div>
      <div class="scrim bottom"></div>

      <!-- HUD frame -->
      <div class="hud" id="hud">
        <span class="br tl"></span><span class="br tr"></span>
        <span class="br bl"></span><span class="br br2"></span>
        <span class="reticle" id="reticle"></span>
      </div>

      <div class="telemetry" id="telemetry">
        <span class="row code"><span class="dot"></span>FACTORY CODE · MONOIDX</span>
        <span class="row">ROT <span class="v ang" id="angle">000°</span></span>
        <span class="row">SEQ <span class="v" id="seq">00 / 05</span></span>
        <span class="row">SYS <span class="v">NOMINAL</span></span>
      </div>

      <!-- right progress rail -->
      <div class="rail" id="rail">
        <div class="seg" data-i="0"><span>Identity</span><span class="tick"></span></div>
        <div class="seg" data-i="1"><span>Origin</span><span class="tick"></span></div>
        <div class="seg" data-i="2"><span>Expertise</span><span class="tick"></span></div>
        <div class="seg" data-i="3"><span>Philosophy</span><span class="tick"></span></div>
        <div class="seg" data-i="4"><span>Operational</span><span class="tick"></span></div>
      </div>

      <!-- big index -->
      <div class="stage-index">
        <span class="big" id="idxBig">00</span><span class="sep">/</span><span>05</span>
        <span class="sep">—</span><span id="idxLabel">SEQUENCE</span>
        <span class="idx-slider" id="expSlider">
          <span class="track" id="expSliderTrack"><span class="fill" id="expSliderFill"></span></span>
          <button class="knob" id="expSliderKnob" type="button" role="slider" aria-label="Drag to reveal professional experience" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></button>
          <span class="slide-label">Slide to show</span>
        </span>
      </div>

      <!-- ACT PANELS -->
      <div class="acts">

        <div class="act act-hero" id="act0">
          <div class="eyebrow no-rule">MX-1 · UNIT-07 · OPERATIONAL</div>
          <h1>MONOIDX</h1>
          <div class="role">Apple Platform Engineer</div>
          <div class="stmt"><span>Building systems.</span><span class="m">Shaping platforms.</span></div>
        </div>

        <div class="act" id="act1">
          <div class="eyebrow">Section 01 — Identity</div>
          <h2>What is<br>MONOIDX?</h2>
          <p class="lede"><b>A digital engineering identity</b> focused on Apple platforms, software architecture and intelligent systems.</p>
        </div>

        <div class="act" id="act2">
          <div class="act2-body" id="act2Body">
            <div class="eyebrow">Section 02 — Expertise</div>
            <h2>Disciplines</h2>
            <div class="chips" id="chips">
              <span class="chip">Swift</span><span class="chip">SwiftUI</span>
              <span class="chip">iOS</span><span class="chip">iPadOS</span>
              <span class="chip">macOS</span><span class="chip">visionOS</span>
              <span class="chip">Platform Architecture</span><span class="chip">AI Assisted Dev</span>
            </div>
            <button class="exp-cue" id="expCue" type="button" aria-controls="resumeDrawer" aria-expanded="false">
              Professional Experience
              <span class="exp-scroll">Scroll<span class="hline"></span></span>
            </button>
          </div>
        </div>

        <div class="act" id="act3">
          <div class="eyebrow">Section 03 — Philosophy</div>
          <h2>Through<br>Simplicity</h2>
          <div class="tenets" id="tenets">
            <div class="tenet"><span class="n">01</span><span class="t">Design for longevity.</span></div>
            <div class="tenet"><span class="n">02</span><span class="t">Reduce complexity.</span></div>
            <div class="tenet"><span class="n">03</span><span class="t">Automate repetition.</span></div>
            <div class="tenet"><span class="n">04</span><span class="t">Build resilient systems.</span></div>
            <div class="tenet"><span class="n">05</span><span class="t">Stay invisible.</span></div>
          </div>
        </div>

        <div class="act" id="act4">
          <div class="eyebrow">Section 04 — Operating System</div>
          <h2>Operational</h2>
          <div class="manifest" id="manifest">
            <div class="mrow"><span class="k">Factory Code</span><span class="v code">MONOIDX</span></div>
            <div class="mrow"><span class="k">Unit</span><span class="v code">MX-1 · UNIT-07</span></div>
            <div class="mrow"><span class="k">Role</span><span class="v">Apple Platform Engineer</span></div>
            <div class="mrow"><span class="k">Status</span><span class="v"><span class="led"></span>Operational</span></div>
          </div>
          <a class="op-portfolio" href="#portfolio"><span>Portfolio</span><span class="ar">↗</span></a>
        </div>

      </div>

      <!-- centered "Professional Experience" resume HUD panel (driven by the scroll module) -->
      <aside class="resume-drawer" id="resumeDrawer" role="dialog" aria-label="Professional Experience" aria-hidden="true">
        <div class="rd-panel" id="rdPanel">
          <span class="br tl"></span><span class="br tr"></span>
          <span class="br bl"></span><span class="br br2"></span>
          <button class="rd-close" id="rdClose" type="button" aria-label="Close">×</button>
          <div class="rd-inner">
            <div class="rd-head">
              <div class="eyebrow no-rule">Section 02 · Curriculum</div>
            </div>

            <div class="rd-id">
              <h3 id="resume-title">{resumeData.name}</h3>
              <div class="rd-role">{resumeData.role}</div>
              <p class="rd-sum">{resumeData.summary}</p>
            </div>

            <div class="rd-exp">
              {resumeData.jobs?.map((job) => (
                <div class="rd-job">
                  <div class="rd-job-h">
                    <span class="rd-job-role">{job.role}</span>
                    <span class="rd-job-when">{job.period}</span>
                  </div>
                  <div class="rd-job-org">{job.org}</div>
                  {hasItems(job.notes) ? (
                    <ul class="rd-job-notes">
                      {job.notes.map((n) => (
                        <li>{parseNote(n).map((s) => (
                          s.project && pfSlugs.has(s.project)
                            ? <button type="button" class="rd-note-link" data-project-link={s.project}>{s.text}</button>
                            : s.text
                        ))}</li>
                      ))}
                    </ul>
                  ) : (
                    job.note && (
                      <p class="rd-job-note">{parseNote(job.note).map((s) => (
                        s.project && pfSlugs.has(s.project)
                          ? <button type="button" class="rd-note-link" data-project-link={s.project}>{s.text}</button>
                          : s.text
                      ))}</p>
                    )
                  )}
                </div>
              ))}
            </div>

            <div class="rd-meta">
              {resumeData.meta?.map((row) => (
                <div class="rd-mrow">
                  <span class="k">{row.label}</span>
                  <div class="rd-mval">
                    <span class="v">{row.led && <span class="led"></span>}{row.value}</span>
                    {row.note && <span class="rd-mrow-note">{row.note}</span>}
                  </div>
                </div>
              ))}
              {hasItems(resumeData.skills) && (
                <div class="rd-mrow">
                  <span class="k">Core Skills</span>
                  <div class="rd-skill-groups">
                    {resumeData.skills.map((group) => (
                      <div class="rd-skill-group">
                        <span class="rd-skill-cat">{group.category}</span>
                        <span class="rd-skill-items">{group.items?.join(' · ')}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
              {resumeData.metaAfter?.map((row) => (
                <div class="rd-mrow">
                  <span class="k">{row.label}</span>
                  <div class="rd-mval">
                    <span class="v">{row.led && <span class="led"></span>}{row.value}</span>
                    {row.note && <span class="rd-mrow-note">{row.note}</span>}
                  </div>
                </div>
              ))}
            </div>

            {hasItems(resumeData.portfolio) && (
              <div class="rd-portfolio">
                {resumeData.portfolio.map((link) => (
                  <a class="rd-portfolio-link" href={link.href}><span>{link.label}</span><span class="ar">↗</span></a>
                ))}
              </div>
            )}
          </div>
        </div>
      </aside>

      <div class="cue" id="cue">Scroll<span class="line"></span></div>
    </div>
  </section>

  <!-- ===================== PORTFOLIO ===================== -->
  <section class="portfolio" id="portfolio" data-screen-label="Portfolio">
    <div class="portfolio-bg" data-depth="0.4"><span>WORK</span></div>
    <div class="wrap pf-wrap">
      <span class="eyebrow anim-up">{portfolioData.eyebrow ?? 'Section 05 — Portfolio'}</span>
      <h2 class="pf-title anim-up">{portfolioData.title ?? 'Selected Work'}</h2>
      {portfolioData.intro && <p class="pf-lede anim-up">{portfolioData.intro}</p>}

      {pfHasFilters && (
        <div class="pf-filter anim-up" id="pfFilter" role="group" aria-label="Filter projects by type">
          <button class="pf-filter-pill is-active" type="button" data-filter="all" aria-pressed="true">All</button>
          {pfContexts.map((c) => (
            <button class="pf-filter-pill" type="button" data-filter={c} aria-pressed="false">{PF_CONTEXT_LABELS[c]}</button>
          ))}
          {pfHasExperimental && (
            <button class="pf-filter-pill" type="button" data-filter="experimental" aria-pressed="false">Experimental</button>
          )}
        </div>
      )}

      <div class="pf-grid" id="pfGrid" data-page-size={PF_PAGE_SIZE}>
        {pfProjects.map((p, i) => (
          <button
            class="pf-card anim-up"
            type="button"
            data-project={p.slug}
            data-context={p.context}
            data-experimental={p.experimental ? 'true' : 'false'}
            aria-haspopup="dialog"
            hidden={i >= PF_PAGE_SIZE}
          >
            <span class="pf-n">{String(i + 1).padStart(2, '0')}</span>
            <div class="pf-card-body">
              <span class="pf-tag">{p.platform}</span>
              <span class="pf-name">{p.title}</span>
              <p class="pf-desc">{p.summary}</p>
            </div>
            <span class="ar">↗</span>
          </button>
        ))}
      </div>

      <nav class="pf-pager anim-up" id="pfPager" aria-label="Selected work pages" hidden>
        <button class="pf-pager-arrow" type="button" data-pf-prev aria-label="Previous projects" disabled>←</button>
        <div class="pf-pager-nums"></div>
        <button class="pf-pager-arrow" type="button" data-pf-next aria-label="Next projects">→</button>
      </nav>
    </div>
  </section>

  <!-- ===================== PORTFOLIO PROJECT HUD (fade in/out) ===================== -->
  <div class="pf-modal" id="pfModal" role="dialog" aria-modal="true" aria-label="Project details" aria-hidden="true">
    {pfProjects.map((p) => (
      <div class="pf-modal-panel" data-project={p.slug}>
        <span class="br tl"></span><span class="br tr"></span>
        <span class="br bl"></span><span class="br br2"></span>
        <button class="rd-close pf-modal-close" type="button" aria-label="Close">×</button>
        <div class="pf-modal-inner">
          <div class="eyebrow no-rule pf-modal-eyebrow">{p.platform}</div>
          <div class="pf-modal-head">
            <h3 class="pf-modal-title" id={`project-title-${p.slug}`}>{p.title}</h3>
            {p.date && <span class="pf-modal-date">{p.date}</span>}
          </div>
          {p.description && <p class="pf-modal-desc">{p.description}</p>}

          {hasItems(p.specs) && (
            <div class="pf-specs">
              {p.specs.map((s) => (
                <div class="pf-spec-row"><span class="k">{s.label}</span><span class="v">{s.value}</span></div>
              ))}
            </div>
          )}

          {(hasItems(p.images) || hasItems(p.videos)) && (
            <div class="pf-gallery">
              {p.images?.map((src) => (
                <img src={src} alt={`${p.title} — preview`} loading="lazy" />
              ))}
              {p.videos?.map((v) => {
                const vsrc = typeof v === 'string' ? v : v.src;
                const poster = typeof v === 'object' && v ? v.poster : undefined;
                return (
                  <video class="pf-video" muted loop playsinline controls preload="metadata" poster={poster}>
                    <source src={vsrc} type="video/mp4" />
                  </video>
                );
              })}
            </div>
          )}

          {hasItems(p.links) && (
            <div class="pf-modal-links">
              {p.links.map((link) => (
                <a class="rd-portfolio-link" href={link.href} target="_blank" rel="noopener noreferrer"><span>{link.label}</span><span class="ar">↗</span></a>
              ))}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>

  <!-- ===================== CONTACT ===================== -->
  <section class="outro" id="contact" data-screen-label="Contact">
    <div class="outro-bg" data-depth="0.4"><span>MONOIDX</span></div>
    <div class="wrap contact2">
      <span class="eyebrow" style="display:flex;justify-content:center">Section 06 — Contact</span>
      <h2 class="big anim-up">Establish Link</h2>
      <div class="links anim-up">
        <a href="https://monoidx.dev"><span>monoidx.dev</span><span class="ar">↗</span></a>
        <a href="https://github.com/smashkins"><span>GitHub</span><span class="ar">↗</span></a>
        <a href="https://linkedin.com/in/monoidx"><span>LinkedIn</span><span class="ar">↗</span></a>
        <a href="mailto:identity@monoidx.dev"><span>Email</span><span class="ar">↗</span></a>
      </div>
    </div>
  </section>

  <footer class="footer2">
    <div class="wrap fg">
      <div>
        <div class="fw">MONOIDX</div>
        <div class="ftag">Built for autonomous operations.</div>
      </div>
      <div class="fmeta">MX-1 · UNIT-07<br>© 2026 — ALL SYSTEMS NOMINAL<br>monoidx.dev</div>
    </div>
  </footer>

  <ToTop label="Back to top" />

  <script is:inline data-astro-rerun>
    // If the visitor was last reading the Italian blog, point the landing's
    // Blog link back to /it/blog/ so their language choice persists.
    try {
      if (localStorage.getItem('monoidx-lang') === 'it') {
        var blogLink = document.querySelector('.nav-links a[href="/blog/"]');
        if (blogLink) blogLink.setAttribute('href', '/it/blog/');
      }
    } catch (e) {}
  </script>

  <script src="../scripts/scroll.ts"></script>
</BaseLayout>
